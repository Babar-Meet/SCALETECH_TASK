# ============================================================
# WhatsApp Song Downloader - Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# Google Gemini API key (used for song classification)
# Leave blank if you don't have one - everything else works,
# classification will just be skipped.
GEMINI_API_KEY=

# Data directories (created automatically if missing)
AUDIO_DIRECTORY=./data/audio
MUSIC_DIRECTORY=./data/music
TRANSCRIPTS_DIRECTORY=./data/transcripts
REPORTS_DIRECTORY=./data/reports
IMPORTS_DIRECTORY=./data/imports

# Whisper transcription settings (faster-whisper)
# Models: tiny, base, small, medium, large-v3
# large-v2 is best quality, small is a good balance.
# Compute types: int8 (fast, low VRAM), float16 (GPU only), int8_float16
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# SQLite database location
DB_PATH=./data/app.db